# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Business Configuration (Authoritative UPI ID)
BUSINESS_UPI_ID=nmallaiah12@axl

# Razorpay Payment Gateway (Optional - if unset, runs in direct UPI QR / test payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin Authentication
ADMIN_INITIAL_PASSWORD=

# Persistent libSQL database required for Vercel (for example, Turso)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Keep webhook request bytes intact in Vercel's Node.js runtime
NODEJS_HELPERS=0
